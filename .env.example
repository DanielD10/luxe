# Copy to .env.local for local dev. In production, set these in
# Vercel → Settings → Environment Variables. Never commit real keys.

# ── Site ────────────────────────────────────────────────────────────
# Canonical URL, used for metadata, sitemap and share cards.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# Shown in the footer, About and error messages. Leave blank to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Legal name for the footer and terms, e.g. "LUXE Travel LLC".
NEXT_PUBLIC_LEGAL_NAME=
# The host agency your advisors book through, e.g. "Fora Travel".
NEXT_PUBLIC_HOST_AGENCY=
# Seller of Travel registration line, e.g. "California CST #1234567-40". Leave blank if none.
NEXT_PUBLIC_SELLER_OF_TRAVEL=

# ── Trip requests (required before launch) ─────────────────────────
# Resend (resend.com). The FROM address must be on a domain you've verified there.
# In production, requests fail loudly if these are missing, so no lead is lost silently.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=LUXE <requests@yourdomain.com>
INQUIRY_TO_EMAIL=

# ── AI (optional) ──────────────────────────────────────────────────
# "gemini" (free tier at aistudio.google.com) or "anthropic" (paid).
# Without these, every AI feature hides itself and the site works without it.
LUXE_AI_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override. Defaults: gemini-flash-latest / claude-haiku-5-5
LUXE_AI_MODEL=

# ── Live public rates (optional) ───────────────────────────────────
# SerpApi Google Hotels (serpapi.com). Powers "Check today's public rate"
# on destination pages. Without it, those pages show the price promise instead.
SERPAPI_KEY=

# ── Affiliate (optional) ───────────────────────────────────────────
# GetYourGuide partner ID. "Browse tours" links earn a commission when set.
NEXT_PUBLIC_GYG_PARTNER_ID=
